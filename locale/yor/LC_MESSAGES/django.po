# --- Chaînes des vues Python ---

msgid "Bienvenue %(username)s ! Ton compte a été créé."
msgstr "Kú àbọ̀, %(username)s! A ti dá àkọọ́lẹ̀ rẹ."

msgid "Ton profil a bien été mis à jour."
msgstr "A ti ṣàtúnṣe profáìlì rẹ dáadáa."

msgid "Impossible de t'ajouter toi-même en ami."
msgstr "Kò ṣeé ṣe láti fi ara rẹ sí ọrẹ́."

msgid "Une demande est déjà en cours ou vous êtes déjà amis."
msgstr "Ìbéèrè kan ti wà tàbí kí ẹ jẹ́ ọrẹ́ tẹ́lẹ̀."

msgid "Demande d'ami envoyée à %(name)s."
msgstr "A ti rán ìbéèrè ọrẹ́ sí %(name)s."

msgid "Vous êtes maintenant amis avec %(name)s."
msgstr "Ẹ̀yin àti %(name)s ti di ọrẹ́."

msgid "Demande d'ami de %(name)s refusée."
msgstr "A ti kọ̀ ìbéèrè ọrẹ́ %(name)s."

msgid "Demande d'ami annulée pour %(name)s."
msgstr "A ti fagilé ìbéèrè ọrẹ́ fún %(name)s."

msgid "Vous n'êtes plus ami avec %(name)s."
msgstr "Ò ì jẹ́ ọrẹ́ %(name)s mọ́."

msgid "Groupe « %(name)s » créé !"
msgstr "Ẹgbẹ́ « %(name)s » ni a dá!"

msgid "Tu as rejoint le groupe « %(name)s »."
msgstr "O ti dara pọ̀ mọ́ ẹgbẹ́ « %(name)s »."

msgid "Tu as quitté le groupe « %(name)s »."
msgstr "O ti jáde kúrò nínú ẹgbẹ́ « %(name)s »."

msgid "Rejoins le groupe avant de pouvoir y publier."
msgstr "Dara pọ̀ mọ́ ẹgbẹ́ kí o tó lè tẹ̀ jáde nínú rẹ̀."

msgid "Publication ajoutée au groupe."
msgstr "A ti fi ìtẹ̀jáde sí ẹgbẹ́."

msgid "Ta publication est vide."
msgstr "Ìtẹ̀jáde rẹ ṣófo."

msgid "Page « %(name)s » créée !"
msgstr "Ojú ìwé « %(name)s » ni a dá!"

msgid "Tu suis maintenant la page « %(name)s »."
msgstr "O ń tẹ̀lé ojú ìwé « %(name)s » nísinsìnyí."

msgid "Tu ne suis plus la page « %(name)s »."
msgstr "Ò ì ń tẹ̀lé ojú ìwé « %(name)s » mọ́."

msgid "Seul le propriétaire peut publier sur sa page."
msgstr "Onílú ojú ìwé nìkan ló lè tẹ̀ jáde lórí rẹ̀."

msgid "Publication ajoutée à la page."
msgstr "A ti fi ìtẹ̀jáde sí ojú ìwé."

msgid "Publication partagée !"
msgstr "Ìtẹ̀jáde tí a pín!"

msgid "Commentaire ajouté."
msgstr "A ti fi ẹ̀sọ̀ sílẹ̀."

msgid "Ton commentaire est vide ou invalide."
msgstr "Ẹ̀sọ̀ rẹ ṣófo tàbí kò tọ́."

msgid "Tu ne peux pas supprimer ce commentaire."
msgstr "O ò lè parẹ́ ẹ̀sọ̀ yìí."

msgid "Commentaire supprimé."
msgstr "A ti parẹ́ ẹ̀sọ̀."

msgid "Impossible de te parler à toi-même."
msgstr "Kò ṣeé ṣe láti bá ara rẹ sọ̀rọ̀."

msgid "Tu ne peux envoyer un message qu'à tes amis."
msgstr "O lè rán ìròyìn sí àwọn ọrẹ́ rẹ nìkan."

